# Thông tin thanh toán hiện trên bản in báo giá.
#
# Vite nhúng các biến VITE_* vào bundle LÚC BUILD, nên phải khai báo đầy đủ
# trên Railway (Service → Variables) TRƯỚC khi deploy. Thiếu biến nào thì bản in
# sẽ hiện "(chưa cấu hình …)" ở chỗ đó.
#
# Chạy local: copy file này thành .env rồi điền giá trị thật (.env đã bị gitignore).

# Email nhận chuyển khoản CAD
VITE_PAY_EMAIL=payment@example.ca

# Ngân hàng VN nhận chuyển khoản VNĐ
VITE_BANK_NAME=Tên ngân hàng
VITE_BANK_HOLDER=Tên chủ tài khoản
VITE_BANK_ACCOUNT=0000000000

# Mã ngân hàng theo chuẩn VietQR, dùng để sinh ảnh QR chuyển khoản (vd: MB, VCB, TCB).
# Khác VITE_BANK_NAME ở trên — cái đó chỉ là tên hiển thị cho người đọc.
# Để trống thì bản in không hiện QR, các phần còn lại vẫn bình thường.
VITE_BANK_CODE=MB
